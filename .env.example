# Environment variables DevAI reads. DevAI never loads .env files (see
# docs/decisions.md, D026): export these in your shell or use a tool such as
# direnv. Never commit a file with real values.

# Required for `devai analyze --ai` (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Optional: model and effort for the AI analysis
DEVAI_AI_MODEL=claude-opus-5-5
DEVAI_AI_EFFORT=medium
