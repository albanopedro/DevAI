# Environment variables DevAI reads. DevAI never loads .env files (see
# docs/decisions.md, D026): export these in your shell or use a tool such as
# direnv. DevAI is 100% free: it never reads or sends an API key.

# Optional: AI provider, "opencode" (default, free models via your OpenCode
# CLI) or "ollama" (local models)
DEVAI_AI_PROVIDER=opencode

# Optional: model. For opencode, only free models are accepted (names ending
# in -free, or big-pickle). Defaults: opencode/space-bunny-free, qwen3.5:9b
DEVAI_AI_MODEL=

# Optional: where Ollama runs (Ollama's own variable). Any host other than
# this computer counts as remote, and DevAI asks before sending.
OLLAMA_HOST=http://localhost:11434
